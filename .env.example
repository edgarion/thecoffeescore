# Turso Database Configuration
# Para obtener estas credenciales, ejecuta en tu terminal con Turso CLI:
#   turso auth login
#   turso db create thecoffeescore
#   turso db show thecoffeescore --url
#   turso db tokens create thecoffeescore
# O desde el panel web de Turso: https://app.turso.tech

# URL de conexión (LibSQL remoto o SQLite local para desarrollo)
TURSO_DATABASE_URL=libsql://thecoffeescore-[tu-usuario].turso.io
# Token de autenticación generado en Turso
TURSO_AUTH_TOKEN=tu-turso-auth-token-aqui

# Fallback local opcional (si no se configuran las variables de Turso, se usará file:local.db automáticamente)
# TURSO_DATABASE_URL=file:local.db
